<%- include("../partials/header") %>

<section class="page-hero auth-hero">
  <p class="eyebrow">Secure Login</p>
  <h1>Welcome back to ZUPPIO.</h1>
  <p>Log in to access your ZUPPIO account using a protected server-side session.</p>
</section>

<section class="section auth-section">
  <div class="auth-panel scroll-reveal">
    <div class="auth-copy">
      <p class="eyebrow">Account Access</p>
      <h2>Log in securely.</h2>
      <p>Your password is never stored directly. ZUPPIO uses hashed passwords, protected cookies, and CSRF checks for account forms.</p>
    </div>

    <form class="auth-form" action="/login" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <% if (typeof error !== "undefined" && error) { %>
        <p class="auth-message error"><%= error %></p>
      <% } %>

      <label for="login-email">Email address</label>
      <input id="login-email" name="email" type="email" value="<%= form.email %>" placeholder="you@zuppio.in" autocomplete="email" required />

      <label for="login-password">Password</label>
      <input id="login-password" name="password" type="password" placeholder="Your password" autocomplete="current-password" required />

      <button class="button primary" type="submit">
        Login
        <i data-lucide="log-in"></i>
      </button>

      <p class="auth-switch">New to ZUPPIO? <a href="/register">Create account</a></p>
    </form>
  </div>
</section>

<%- include("../partials/footer") %>

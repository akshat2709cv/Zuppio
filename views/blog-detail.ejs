<%- include("partials/header") %>

<%
  const posts = Array.isArray(managedBlogPosts) ? managedBlogPosts : [];
  const blogImage = blog.image || "/images/home-hero-zuppio.png";
  const blogParagraphs = Array.isArray(blog.content)
    ? blog.content
    : String(blog.content || blog.body || blog.description || "").split(/\n\s*\n/);
  const categoryAliases = {
    "Brand Story": "Product Stories",
    "Snack Culture": "Lifestyle",
    "Quality": "Quality & Process",
    "Food Ideas": "Lifestyle",
    "Product Updates": "Product Stories"
  };
  const detailCategory = categoryAliases[blog.category] || blog.category || "Product Stories";
  const categoryList = ["All Categories", "Product Stories", "Recipes", "Quality & Process", "Lifestyle", "Business & Partners"];
  function displayCategory(category) {
    return categoryAliases[category] || category || "Product Stories";
  }
  function categoryCount(category) {
    if (category === "All Categories") return posts.length;
    return posts.filter(function(post) { return displayCategory(post.category) === category; }).length;
  }
  function formatDate(index) {
    const date = new Date(2024, 4, Math.max(1, 20 - (index * 2)));
    return date.toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" });
  }
  const popularPosts = posts.filter(function(post) { return post.slug !== blog.slug; }).slice(0, 5);
%>

<section class="blog-detail-shell section">
  <article class="blog-article">
    <nav class="blog-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <a href="/blogs">Blogs</a>
      <span>›</span>
      <span><%= detailCategory %></span>
      <span>›</span>
      <strong><%= blog.title %></strong>
    </nav>

    <span class="blog-detail-badge"><%= detailCategory %></span>
    <h1><%= blog.title %></h1>
    <p class="blog-detail-summary"><%= blog.description %></p>

    <div class="blog-author-row">
      <span class="blog-author-logo"><img src="/images/logo1.png" alt="" /></span>
      <span>By Team ZUPPIO</span>
      <span>&bull;</span>
      <span>May 20, 2024</span>
      <span>&bull;</span>
      <span>4 min read</span>
      <div class="blog-share-row" aria-label="Share">
        <strong>Share:</strong>
        <a href="#" aria-label="Share on Facebook">f</a>
        <a href="#" aria-label="Share on Twitter">x</a>
        <a href="#" aria-label="Share on WhatsApp">w</a>
        <a href="#" aria-label="Copy link"><i data-lucide="link"></i></a>
      </div>
    </div>

    <img class="blog-detail-image blog-detail-main-image" src="<%= blogImage %>" alt="<%= blog.title %>" />

    <div class="blog-detail-copy">
      <h2>It All Started with a Simple Idea</h2>
      <% blogParagraphs.filter(function(paragraph) { return paragraph && paragraph.trim(); }).forEach(function(paragraph) { %>
        <p><%= paragraph.trim() %></p>
      <% }) %>

      <h2>Our Promise</h2>
      <div class="blog-promise-grid">
        <article>
          <i data-lucide="cookie"></i>
          <strong>Finest Potatoes</strong>
          <span>Carefully selected for the perfect crunch.</span>
        </article>
        <article>
          <i data-lucide="droplet"></i>
          <strong>Quality Ingredients</strong>
          <span>Real ingredients, real flavors.</span>
        </article>
        <article>
          <i data-lucide="shield-check"></i>
          <strong>Hygienic Process</strong>
          <span>Made with strict quality checks.</span>
        </article>
        <article>
          <i data-lucide="smile"></i>
          <strong>Spreading Smiles</strong>
          <span>Snack moments made happier.</span>
        </article>
      </div>

      <h2>A Journey of Smiles</h2>
      <p>From our first pack to your hands, every step of our journey has been about trust, quality, and joy. Thank you for being a part of the ZUPPIO family.</p>

      <aside class="blog-flavor-banner">
        <img src="/images/banner.jpeg" alt="ZUPPIO flavor packs" />
        <div>
          <h3>Try Our Delicious Flavors</h3>
          <p>Crispy, crunchy and full of flavors. Which one is your favorite?</p>
          <a href="/product-categories">Explore Products <i data-lucide="arrow-right"></i></a>
        </div>
      </aside>
    </div>
  </article>

  <aside class="blog-sidebar" aria-label="Blog sidebar">
    <section class="blog-sidebar-card">
      <h2>Search Blogs</h2>
      <label class="blog-search">
        <input type="search" placeholder="Search here..." />
        <i data-lucide="search"></i>
      </label>
    </section>

    <section class="blog-sidebar-card">
      <h2>Categories</h2>
      <div class="blog-category-list">
        <% categoryList.forEach(function(category) { %>
          <a class="<%= category === detailCategory ? 'active' : '' %>" href="/blogs">
            <span><%= category %></span>
            <small><%= categoryCount(category) %></small>
          </a>
        <% }) %>
      </div>
    </section>

    <section class="blog-sidebar-card">
      <h2>Popular Posts</h2>
      <div class="blog-popular-list">
        <% popularPosts.forEach(function(post, index) { %>
          <a href="/blogs/<%= post.slug %>">
            <img src="<%= post.image || '/images/home-hero-zuppio.png' %>" alt="" />
            <span>
              <strong><%= post.title %></strong>
              <small><%= formatDate(index + 1) %></small>
            </span>
          </a>
        <% }) %>
      </div>
    </section>

    <section class="blog-sidebar-card blog-subscribe-card">
      <i data-lucide="mail"></i>
      <h2>Stay Updated With ZUPPIO</h2>
      <p>Subscribe to get the latest news, new product updates and exciting offers.</p>
      <form action="/snack-drop-alerts" method="post">
        <input type="email" name="email" placeholder="Enter your email" required />
        <button type="submit">Subscribe</button>
      </form>
    </section>
  </aside>
</section>

<%- include("partials/footer") %>

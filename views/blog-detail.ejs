<%- include("partials/header") %>

<%
  const blogImage = blog.image || "/images/home-hero-zuppio.png";
  const blogParagraphs = Array.isArray(blog.content)
    ? blog.content
    : String(blog.content || blog.body || blog.description || "").split(/\n\s*\n/);
%>

<section class="command-page-hero blog-detail-hero">
  <nav class="breadcrumb command-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span>/</span>
    <a href="/blogs">Blogs</a>
    <span>/</span>
    <span><%= blog.title %></span>
  </nav>

  <p class="command-label"><%= blog.category || "ZUPPIO Blog" %></p>
  <h1><%= blog.title %></h1>
  <p class="blog-detail-summary"><%= blog.description %></p>
</section>

<section class="section blog-detail-section">
  <article class="blog-detail-card">
    <img class="blog-detail-image" src="<%= blogImage %>" alt="<%= blog.title %>" />

    <div class="blog-detail-copy">
      <% if (blog.tags && blog.tags.length) { %>
        <div class="blog-tag-row" aria-label="Blog tags">
          <% blog.tags.forEach(function(tag) { %>
            <span><%= tag %></span>
          <% }) %>
        </div>
      <% } %>

      <% blogParagraphs.filter(function(paragraph) { return paragraph && paragraph.trim(); }).forEach(function(paragraph) { %>
        <p><%= paragraph.trim() %></p>
      <% }) %>
    </div>
  </article>

  <div class="policy-actions">
    <a class="back-to-terms" href="/blogs">Back to Blogs</a>
  </div>
</section>

<%- include("partials/footer") %>

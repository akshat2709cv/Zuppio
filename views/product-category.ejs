    beverages: {
      heroText: "Refreshing drinks made for chilled moments, bright flavors, and everyday Indian taste.",
      rangeLabel: "Drink Range",
      rangeTitle: "Explore Beverages",
      rangeText: "A future-ready beverage shelf with cola drink, orange drink, energy drink, and lemon soda options.",
      range: [
        { title: "Cola Drink", image: "/images/product-categories/beverages-cola-card.png", theme: "cola-drink", text: "Classic cola refreshment with chilled sparkle and bold taste.", tags: ["Cola", "Classic"] },
        { title: "Orange Drink", image: "/images/product-categories/beverages-orange-card.png", theme: "orange-drink", text: "Bright orange flavor planned for fruity refreshment moments.", tags: ["Orange", "Fruity"] },
        { title: "Energy Drink", image: "/images/product-categories/beverages-energy-card.jpg", theme: "energy-drink", text: "Power-packed refreshment for active and high-energy occasions.", tags: ["Energy", "Bold"] },

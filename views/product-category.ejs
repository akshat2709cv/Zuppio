        { title: "Orange Cream Biscuit", image: "/images/product-categories/biscuit-orange-cream-card.png", theme: "orange-cream-biscuit", text: "Orange-flavored cream biscuit with a sweet citrus center.", tags: ["Orange", "Cream"] },
        { title: "Digestive Biscuits", image: "/images/product-categories/biscuit-digestive-card.png", theme: "digestive-biscuit", text: "Everyday digestive biscuits for tea-time and light snacking.", tags: ["Digestive", "Tea Time"] },
        { title: "Elaichi Cream Biscuit", image: "/images/product-categories/biscuit-elaichi-card.png", theme: "elaichi-biscuit", text: "Elaichi cream biscuit flavor planned around familiar Indian sweetness.", tags: ["Elaichi", "Cream"] },

        { icon: "leaf", title: "Indian Flavors", text: "Familiar taste cues like zeera, lemon, and mango." },
        { icon: "droplets", title: "Served Chilled", text: "Built to feel bright, cool, and refreshing." },
        { icon: "shopping-bag", title: "Shelf Friendly", text: "A clear future beverage range for retail displays." }
      ],
      momentLabel: "Refresh Moments",
      momentTitle: "Sip For Every Occasion",
      momentText: "From daily hydration to energy moments, ZUPPIO beverages are planned for modern routines.",
      momentButton: "Refreshing taste ahead"
    },
    biscuit: {

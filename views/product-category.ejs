        { title: "Coconut Biscuit", image: "/images/product-categories/biscuit-coconut-card.png", theme: "coconut-biscuit", text: "Coconut biscuit flavor for a simple bakery-style bite.", tags: ["Coconut", "Bakery"] }
      ],
      benefitsTitle: "Made For Every Tea-Time Moment",
      benefits: [
        { icon: "cookie", title: "Bakery Appeal", text: "Formats designed for simple snack routines." },
        { icon: "coffee", title: "Tea Partner", text: "Made to sit naturally beside chai and coffee." },
        { icon: "package", title: "Retail Ready", text: "Clear formats for future shelf expansion." },

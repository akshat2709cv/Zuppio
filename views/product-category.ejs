      benefits: [
        { icon: "banana", title: "Banana Crunch", text: "A familiar Indian snack with crisp texture." },
        { icon: "salt", title: "Classic Taste", text: "Simple salted ideas planned for easy reach." },
        { icon: "sparkles", title: "Flavor Twists", text: "Future variants can carry ZUPPIO taste energy." },

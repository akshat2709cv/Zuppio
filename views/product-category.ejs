        { title: "Gulab Jamun", image: "/images/product-categories/ready-gulab-jamun.png", theme: "gulab-jamun", icon: "sparkles", text: "Sweet ready-to-eat dessert product for celebration moments.", tags: ["Dessert", "Sweet"] }
      ],
      benefitsTitle: "Made For Every Quick Meal",
      benefits: [
        { icon: "timer", title: "Fast Ready", text: "Designed for quick preparation and busy routines." },
        { icon: "utensils", title: "Meal Friendly", text: "Comforting food ideas for everyday moments." },
        { icon: "briefcase", title: "Travel Useful", text: "Convenient formats for work, trips, and hostels." },
        { icon: "cup-soda", title: "Everyday Fit", text: "Built around practical modern consumption." }
      ],
      momentLabel: "Meal Moments",
      momentTitle: "Quick Food For Busy Days",
      momentText: "From morning rush to late cravings, ZUPPIO ready-to-eat ideas are planned for speed and comfort.",
      momentButton: "Ready-to-eat coming soon"
    }
  };

  const design = categoryDesigns[slug] || categoryDesigns["potato-chips"];
  const rangeCards = design.range;
  const heroVisuals = rangeCards.slice(0, 3);
  const heroLeftImage = design.heroLeftImage || (heroVisuals[0] && heroVisuals[0].image);
  const heroText = category.description || design.heroText;
  const momentImage = category.banner || category.image || (rangeCards[0] && rangeCards[0].image);
%>

<section class="category-showcase-page category-theme-<%= slug %>">
  <section class="category-showcase-hero">
    <div class="category-hero-chips left" aria-hidden="true">
      <% if (heroLeftImage) { %>
        <img src="<%= heroLeftImage %>" alt="" />
      <% } %>
    </div>
    <div class="category-hero-copy">
      <p class="eyebrow">Product Category</p>
      <h1><%= category.title %></h1>
      <p><%= heroText %></p>
    </div>
    <div class="category-hero-packs" aria-hidden="true">
      <% heroVisuals.forEach(function(item) { %>
        <img src="<%= item.image %>" alt="" />
      <% }) %>
    </div>
  </section>

  <section class="section category-range-section">
    <div class="section-kicker">
      <p class="eyebrow"><%= design.rangeLabel %></p>
      <h2><%= design.rangeTitle %></h2>
      <p><%= design.rangeText %></p>
    </div>

    <div class="category-range-grid">
      <% rangeCards.forEach(function(item, index) { %>
        <article class="category-range-card <%= item.theme ? 'category-range-card-' + item.theme : '' %> scroll-reveal" style="--delay: <%= index * 80 %>ms">
          <div class="category-range-media">
            <img src="<%= item.image %>" alt="<%= item.title %>" />
          </div>
          <div class="category-range-info">
            <span class="category-range-icon" aria-hidden="true"><i data-lucide="<%= item.icon || design.benefits[0].icon || 'sparkles' %>"></i></span>
            <div class="category-range-copy">
              <h3><%= item.title %></h3>
              <p><%= item.text %></p>
              <div class="category-range-tags">
                <% item.tags.slice(0, 2).forEach(function(tag) { %>
                  <span><%= tag %></span>
                <% }) %>
              </div>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <section class="section category-love-section">
    <div class="section-kicker compact">
      <p class="eyebrow">Why You'll Love It</p>
      <h2><%= design.benefitsTitle %></h2>
    </div>
    <div class="category-benefit-grid">
      <% design.benefits.forEach(function(item, index) { %>
        <article class="category-benefit-card scroll-reveal" style="--delay: <%= index * 70 %>ms">
          <span><i data-lucide="<%= item.icon %>"></i></span>
          <h3><%= item.title %></h3>
          <p><%= item.text %></p>
        </article>
      <% }) %>
    </div>
  </section>

  <section class="section category-moment-section">
    <div class="category-moment-panel scroll-reveal">
      <div class="category-moment-image">
        <img src="<%= momentImage %>" alt="<%= category.title %> snack moment" />
      </div>
      <div class="category-moment-copy">
        <p class="eyebrow"><%= design.momentLabel %></p>
        <h2><%= design.momentTitle %></h2>
        <p><%= design.momentText %></p>
        <span><i data-lucide="smile"></i> <%= design.momentButton %></span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="product-contact-panel category-contact-panel scroll-reveal">
      <div>
        <p class="eyebrow"><%= businessPanel.label %></p>
        <h2><%= businessPanel.title %></h2>
        <p><%= businessPanel.text %></p>
      </div>
      <div class="category-contact-products" aria-hidden="true">
        <img class="category-contact-mascot" src="/images/product-categories/zuppio-chips-cartoon-mascot.png" alt="" />
      </div>
      <a class="button primary" href="<%= businessPanel.buttonLink %>">
        <%= businessPanel.buttonText %>
        <i data-lucide="user"></i>
      </a>
    </div>
  </section>
</section>

<%- include("partials/footer") %>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'ZUPPIO is a premium modern snack brand with bold chips flavors and fresh snack drops.' %>" />
    <% if (typeof noindex !== "undefined" && noindex) { %><meta name="robots" content="noindex,nofollow" /><% } %>
    <% if (typeof canonicalUrl !== "undefined" && canonicalUrl) { %><link rel="canonical" href="<%= canonicalUrl %>" /><% } %>
    <% if (typeof ogImage !== "undefined" && ogImage) { %><meta property="og:image" content="<%= ogImage %>" /><% } %>
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@12.2.0/swiper-bundle.min.css" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body class="loading">
    <div class="loader-screen" id="loaderScreen" aria-hidden="true">
      <div class="loader-pack">
        <img src="/images/logo1.png" alt="" />
      </div>
      
    </div>

    <div class="cursor-glow" id="cursorGlow" aria-hidden="true"></div>

    <header class="site-header">
      <a class="logo" href="/" aria-label="ZUPPIO home">
        <img class="navbar-logo" src="<%= siteHeader && siteHeader.logo ? siteHeader.logo : '/images/zuppio-navbar-logo.png' %>" alt="ZUPPIO" />
      </a>

      <nav class="navbar" id="navbar">
        <button class="drawer-close" type="button" data-drawer-close aria-label="Close menu">
          <i data-lucide="x"></i>
        </button>
        <% (typeof pages !== "undefined" ? pages : []).forEach(function(page) { %>
          <%
            const activeAliases = {
              Products: ["Product Categories"],
              "Where To Buy": ["How To Buy"],
              Term: ["Terms"]
            };
            const isActivePage = activePage === page.label || (activeAliases[page.label] || []).includes(activePage);
          %>
          <a class="<%= isActivePage ? 'active' : '' %>" href="<%= page.href %>"><%= page.label %></a>
        <% }) %>
      </nav>

      <button class="menu-button" id="menuButton" type="button" aria-label="Open menu" aria-controls="navbar" aria-expanded="false">
        <i data-lucide="menu"></i>
      </button>
    </header>
    <div class="drawer-scrim" id="drawerScrim" data-drawer-close aria-hidden="true"></div>

    <main>

<%- include("partials/shell-open") %>

<%
  const navItems = (state.header.navItems || []).concat([{ label: "", href: "", order: (state.header.navItems || []).length + 1, visible: false }]);
  const exploreLinks = (state.footer.exploreLinks || []).concat([{ label: "", href: "", order: (state.footer.exploreLinks || []).length + 1, visible: false }]);
  const socialLinks = (state.footer.socialLinks || []).concat([{ label: "", url: "", icon: "", visible: false }]);
%>

<section class="admin-card">
  <div class="cms-section-heading">
    <p class="admin-kicker">Global Website Layout</p>
    <h2>Header / Footer</h2>
    <p class="admin-note">Update the live navbar, footer brand details, social links, and footer background. Use the Media Manager for uploads, then paste the generated image path here.</p>
  </div>
  <% if (message) { %><div class="admin-alert success"><%= message %></div><% } %>
  <form class="admin-form compact" method="post" action="/admin/layout">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <section class="cms-group">
      <div class="cms-section-heading">
        <h2>Header</h2>
        <p class="admin-note">Logo and main navigation menu shown on the public website.</p>
      </div>
      <label class="wide">Logo Image Path<input name="logo" value="<%= state.header.logo %>" /></label>
      <div class="admin-table-wrap wide">
        <table class="admin-table">
          <thead><tr><th>Label</th><th>URL</th><th>Order</th><th>Show</th></tr></thead>
          <tbody>
            <% navItems.forEach(function(item, index) { %>
              <tr>
                <td><input name="navLabel" value="<%= item.label %>" placeholder="Menu label" /></td>
                <td><input name="navHref" value="<%= item.href %>" placeholder="/page-url" /></td>
                <td><input name="navOrder" type="number" value="<%= item.order || index + 1 %>" /></td>
                <td><input type="checkbox" name="navVisible<%= index %>" <%= item.visible ? "checked" : "" %> /></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="cms-group">
      <div class="cms-section-heading">
        <h2>Footer Brand</h2>
        <p class="admin-note">Company identity, contact details, WhatsApp link, copyright, and footer background.</p>
      </div>
      <label>Brand Name<input name="brandName" value="<%= state.footer.brandName || state.settings.brandName %>" /></label>
      <label class="wide">Footer Brand Text<input name="brandText" value="<%= state.footer.brandText %>" /></label>
      <label>Phone<input name="phone" value="<%= state.footer.phone %>" /></label>
      <label>Email<input name="email" value="<%= state.footer.email %>" /></label>
      <label class="wide">WhatsApp Link<input name="whatsappLink" value="<%= state.footer.whatsappLink %>" /></label>
      <label class="wide">Copyright Text<input name="copyrightText" value="<%= state.footer.copyrightText %>" /></label>
      <label class="wide">Footer Background Image<input name="backgroundImage" value="<%= state.footer.backgroundImage || '' %>" /></label>
    </section>

    <section class="cms-group">
      <div class="cms-section-heading">
        <h2>Footer Explore Links</h2>
        <p class="admin-note">Links shown in the footer Explore column.</p>
      </div>
      <div class="admin-table-wrap wide">
        <table class="admin-table">
          <thead><tr><th>Label</th><th>URL</th><th>Order</th><th>Show</th></tr></thead>
          <tbody>
            <% exploreLinks.forEach(function(item, index) { %>
              <tr>
                <td><input name="exploreLabel" value="<%= item.label %>" placeholder="Footer link" /></td>
                <td><input name="exploreHref" value="<%= item.href %>" placeholder="/page-url" /></td>
                <td><input name="exploreOrder" type="number" value="<%= item.order || index + 1 %>" /></td>
                <td><input type="checkbox" name="exploreVisible<%= index %>" <%= item.visible ? "checked" : "" %> /></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="cms-group">
      <div class="cms-section-heading">
        <h2>Social Media Links</h2>
        <p class="admin-note">Social card labels, URLs, and icon image paths.</p>
      </div>
      <div class="admin-table-wrap wide">
        <table class="admin-table">
          <thead><tr><th>Label</th><th>URL</th><th>Icon Image</th><th>Show</th></tr></thead>
          <tbody>
            <% socialLinks.forEach(function(item, index) { %>
              <tr>
                <td><input name="socialLabel" value="<%= item.label %>" placeholder="Instagram" /></td>
                <td><input name="socialUrl" value="<%= item.url %>" placeholder="https://..." /></td>
                <td><input name="socialIcon" value="<%= item.icon %>" placeholder="/images/icon.png" /></td>
                <td><input type="checkbox" name="socialVisible<%= index %>" <%= item.visible ? "checked" : "" %> /></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <div class="admin-actions">
      <button class="admin-button" type="submit">Save Layout</button>
    </div>
  </form>
</section>

<%- include("partials/shell-close") %>

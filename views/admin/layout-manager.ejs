<%- include("partials/shell-open") %>

<section class="admin-card">
  <h2>Header & Footer</h2>
  <p class="admin-note">These fields update the live navbar and footer after refresh. Link lists are JSON arrays so order, labels, links, and visibility can be managed together.</p>
  <% if (message) { %><div class="admin-alert success"><%= message %></div><% } %>
  <form class="admin-form compact" method="post" action="/admin/layout">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label class="wide">Logo Image<input name="logo" value="<%= state.header.logo %>" /></label>
    <label class="wide">Footer Brand Text<input name="brandText" value="<%= state.footer.brandText %>" /></label>
    <label>Phone<input name="phone" value="<%= state.footer.phone %>" /></label>
    <label>Email<input name="email" value="<%= state.footer.email %>" /></label>
    <label class="wide">WhatsApp Link<input name="whatsappLink" value="<%= state.footer.whatsappLink %>" /></label>
    <label class="wide">Copyright Text<input name="copyrightText" value="<%= state.footer.copyrightText %>" /></label>
    <label class="wide">Navbar Items JSON<textarea class="json-editor" name="navItems" rows="10"><%= JSON.stringify(state.header.navItems, null, 2) %></textarea></label>
    <label class="wide">Footer Explore Links JSON<textarea class="json-editor" name="exploreLinks" rows="10"><%= JSON.stringify(state.footer.exploreLinks, null, 2) %></textarea></label>
    <label class="wide">Social Links JSON<textarea class="json-editor" name="socialLinks" rows="10"><%= JSON.stringify(state.footer.socialLinks, null, 2) %></textarea></label>
    <button class="admin-button" type="submit">Save Layout</button>
  </form>
</section>

<%- include("partials/shell-close") %>

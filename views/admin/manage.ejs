<%- include("partials/shell-open") %>

<%
  function list(value) { return Array.isArray(value) ? value.join(", ") : (value || ""); }
  function selected(value, expected) { return String(value || "") === expected ? "selected" : ""; }
  function checked(value) { return value ? "checked" : ""; }
  function inquiryStatus(value) { return ["Read", "Replied"].includes(value) ? value : "New"; }
  function escapeHtml(value) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }
  function imageList(value) {
    if (Array.isArray(value)) return value.filter(Boolean);
    return String(value || "").split(",").map(function(item) { return item.trim(); }).filter(Boolean);
  }
  function renderImagePreviews(images, label) {
    if (!images.length) return '<span class="cms-image-empty">No image selected</span>';
    return images.map(function(image) {
      return '<img src="' + escapeHtml(image) + '" alt="' + escapeHtml(label) + ' preview" />';
    }).join("");
  }
  function renderImageUploadControl(options) {
    const images = imageList(options.value);
    const hiddenValue = images.join(", ");
    const inputId = options.id;
    return `
      <div class="cms-image-field wide" data-admin-image-field>
        <input type="hidden" name="${escapeHtml(options.valueName)}" value="${escapeHtml(hiddenValue)}" data-image-value />
        <div class="cms-image-field-header">
          <strong>${escapeHtml(options.label)}</strong>
          <span>Current Image Preview</span>
        </div>
        <div class="cms-image-preview-list" data-image-preview-list>
          ${renderImagePreviews(images, options.label)}
        </div>
        <div class="admin-actions cms-image-actions">
          <label class="admin-button ghost cms-file-button" for="${escapeHtml(inputId)}">
            Choose Image
            <input id="${escapeHtml(inputId)}" name="${escapeHtml(options.fileName)}" type="file" accept="image/jpeg,image/png,image/webp,image/svg+xml" data-image-file ${options.multiple ? "multiple" : ""} hidden />
          </label>
          <button class="admin-button danger" type="button" data-image-remove ${images.length ? "" : "hidden"}>Remove Image</button>
        </div>
      </div>
    `;
  }
  const categoryNames = (state.productCategories || []).map(function(category) { return category.name; });
  const submissions = state.submissions || {};
%>

<% if (kind === "content") { %>
  <section class="admin-list">
    <% state.content.forEach(function(item) { %>
      <form class="admin-card admin-form" method="post" action="/admin/content/<%= item.id %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label>Title<input name="title" value="<%= item.title %>" required /></label>
        <label>Status<select name="status"><option <%= selected(item.status, "published") %>>published</option><option <%= selected(item.status, "draft") %>>draft</option></select></label>
        <label class="wide">Body<textarea name="body" rows="5"><%= item.body %></textarea></label>
        <button class="admin-button" type="submit">Save Content</button>
      </form>
    <% }) %>
  </section>
<% } %>

<% if (kind === "products") { %>
  <form class="admin-card admin-form compact" method="post" action="/admin/products" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="cms-section-heading"><h2>Add Product</h2><p class="admin-note">Create products that can later be surfaced on public category pages.</p></div>
    <label>Product Name<input name="name" required /></label>
    <label>Slug<input name="slug" placeholder="seedha-simple" /></label>
    <label>Category<select name="category"><% categoryNames.forEach(function(name) { %><option><%= name %></option><% }) %></select></label>
    <label>Flavor Name<input name="flavour" /></label>
    <label>Price Placeholder<input name="price" placeholder="Coming soon" /></label>
    <label>Weight<input name="weight" placeholder="52 g" /></label>
    <label>Status<select name="status"><option>Active</option><option>Draft</option><option>Archived</option></select></label>
    <label class="toggle-label"><input type="checkbox" name="featured" /> <span>Featured product</span></label>
    <%- renderImageUploadControl({ label: "Product Images", value: [], valueName: "images", fileName: "productImages", id: "new-product-images", multiple: true }) %>
    <label class="wide">Description<textarea name="description" rows="4"></textarea></label>
    <label class="wide">Offer / Badge Text<input name="offers" /></label>
    <button class="admin-button" type="submit">Add Product</button>
  </form>

  <section class="admin-list">
    <% state.products.forEach(function(product) { %>
      <article class="admin-card">
        <form class="admin-form compact" method="post" action="/admin/products/<%= product.id %>" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="cms-section-heading"><h2><%= product.name %></h2><p class="admin-note"><%= product.category %> · <%= product.status %></p></div>
          <label>Product Name<input name="name" value="<%= product.name %>" /></label>
          <label>Slug<input name="slug" value="<%= product.slug || '' %>" /></label>
          <label>Category<select name="category"><% categoryNames.forEach(function(name) { %><option <%= selected(product.category, name) %>><%= name %></option><% }) %></select></label>
          <label>Flavor Name<input name="flavour" value="<%= product.flavour %>" /></label>
          <label>Price Placeholder<input name="price" value="<%= product.price %>" /></label>
          <label>Weight<input name="weight" value="<%= product.weight || product.packetSize || '' %>" /></label>
          <label>Status<select name="status"><option <%= selected(product.status, "Active") %>>Active</option><option <%= selected(product.status, "Draft") %>>Draft</option><option <%= selected(product.status, "Archived") %>>Archived</option></select></label>
          <label class="toggle-label"><input type="checkbox" name="featured" <%= checked(product.featured) %> /> <span>Featured product</span></label>
          <%- renderImageUploadControl({ label: "Product Images", value: product.images, valueName: "images", fileName: "productImages", id: "product-images-" + product.id, multiple: true }) %>
          <label class="wide">Description<textarea name="description" rows="4"><%= product.description %></textarea></label>
          <label class="wide">Offer / Badge Text<input name="offers" value="<%= product.offers %>" /></label>
          <button class="admin-button" type="submit">Save Product</button>
        </form>
        <form class="admin-actions" method="post" action="/admin/products/<%= product.id %>/delete">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="admin-button danger" type="submit">Delete Product</button>
        </form>
      </article>
    <% }) %>
  </section>
<% } %>

<% if (kind === "categories") { %>
  <form class="admin-card admin-form compact" method="post" action="/admin/categories">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label>Name<input name="name" required /></label><label>Tags<input name="tags" /></label><label>Flavour<input name="flavour" /></label><label>Size<input name="size" /></label><label>Colour<input name="colour" /></label><label>Variations<input name="variations" /></label><label>Product Type<input name="productType" /></label><label>Status<input name="status" /></label>
    <button class="admin-button" type="submit">Add Category</button>
  </form>
  <section class="admin-list">
    <% state.categories.forEach(function(category) { %>
      <form class="admin-card admin-form compact" method="post" action="/admin/categories/<%= category.id %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label>Name<input name="name" value="<%= category.name %>" /></label><label>Tags<input name="tags" value="<%= list(category.tags) %>" /></label><label>Flavour<input name="flavour" value="<%= category.flavour %>" /></label><label>Size<input name="size" value="<%= category.size %>" /></label><label>Colour<input name="colour" value="<%= category.colour %>" /></label><label>Variations<input name="variations" value="<%= category.variations %>" /></label><label>Product Type<input name="productType" value="<%= category.productType %>" /></label><label>Status<input name="status" value="<%= category.status %>" /></label>
        <button class="admin-button" type="submit">Save Category</button>
      </form>
    <% }) %>
  </section>
<% } %>

<% if (kind === "media") { %>
  <form class="admin-card admin-form" method="post" action="/admin/media" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="cms-section-heading"><h2>Upload Media</h2><p class="admin-note">Organize uploads by naming them clearly: Logo, Product image, Category icon, Blog image, QR code, Banner, Footer background, or General upload.</p></div>
    <label>Name<input name="name" placeholder="Product image - Seedha Simple" /></label>
    <label>Image File<input name="media" type="file" accept="image/jpeg,image/png,image/webp,image/svg+xml" required /></label>
    <button class="admin-button" type="submit">Upload Image</button>
  </form>
  <section class="media-grid">
    <% state.media.forEach(function(media) { %>
      <article class="admin-card media-card">
        <img src="<%= media.url %>" alt="<%= media.name %>" />
        <strong><%= media.name %></strong>
        <code><%= media.url %></code>
        <form method="post" action="/admin/media/<%= media.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="admin-button danger" type="submit">Delete</button></form>
      </article>
    <% }) %>
  </section>
<% } %>

<% if (kind === "swiper") { %>
  <section class="admin-list">
    <% state.swiperSlides.forEach(function(slide) { %>
      <form class="admin-card admin-form" method="post" action="/admin/swiper/<%= slide.id %>" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="cms-section-heading"><h2><%= slide.title %></h2><p class="admin-note">Responsive banner images for desktop, tablet, and mobile.</p></div>
        <label>Title<input name="title" value="<%= slide.title %>" /></label><label>Status<input name="status" value="<%= slide.status %>" /></label>
        <%- renderImageUploadControl({ label: "Desktop Image", value: slide.desktopImage || "", valueName: "desktopImage", fileName: "desktopUpload", id: "swiper-desktop-" + slide.id, multiple: false }) %>
        <%- renderImageUploadControl({ label: "Tablet Image", value: slide.tabletImage || "", valueName: "tabletImage", fileName: "tabletUpload", id: "swiper-tablet-" + slide.id, multiple: false }) %>
        <%- renderImageUploadControl({ label: "Mobile Image", value: slide.mobileImage || "", valueName: "mobileImage", fileName: "mobileUpload", id: "swiper-mobile-" + slide.id, multiple: false }) %>
        <label class="wide">Alt Text<input name="alt" value="<%= slide.alt %>" /></label>
        <picture class="admin-preview"><source media="(max-width: 640px)" srcset="<%= slide.mobileImage %>" /><source media="(max-width: 1024px)" srcset="<%= slide.tabletImage %>" /><img src="<%= slide.desktopImage %>" alt="<%= slide.alt %>" /></picture>
        <button class="admin-button" type="submit">Save Responsive Slide</button>
      </form>
    <% }) %>
  </section>
<% } %>

<% if (kind === "product-category-page") { %>
  <%
    const productPage = state.productCategoryPage || {};
    const overview = productPage.overview || {};
    const businessPanel = productPage.businessPanel || {};
    const sliderSlides = (productPage.suggestionSlides || []).sort(function(a, b) { return Number(a.order || 0) - Number(b.order || 0); });
  %>

  <form class="admin-card admin-form" method="post" action="/admin/product-category-page">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="cms-section-heading"><h2>Product Category Page Copy</h2><p class="admin-note">Heading and business CTA content shown below the product banner slider.</p></div>
    <label>Overview Label<input name="overviewLabel" value="<%= overview.label || '' %>" /></label>
    <label>Overview Heading<input name="overviewTitle" value="<%= overview.title || '' %>" /></label>
    <label>Business Label<input name="businessLabel" value="<%= businessPanel.label || '' %>" /></label>
    <label>Business Heading<input name="businessTitle" value="<%= businessPanel.title || '' %>" /></label>
    <label class="wide">Business Description<textarea name="businessText" rows="3"><%= businessPanel.text || '' %></textarea></label>
    <label>Business Button Text<input name="businessButtonText" value="<%= businessPanel.buttonText || '' %>" /></label>
    <label>Business Button Link<input name="businessButtonLink" value="<%= businessPanel.buttonLink || '' %>" /></label>
    <button class="admin-button" type="submit">Save Page Copy</button>
  </form>

  <form class="admin-card admin-form" method="post" action="/admin/product-category-page/slides" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="cms-section-heading"><h2>Add Product Banner Slide</h2><p class="admin-note">Upload a finished banner image. Public slider shows only the image, no text overlay. Recommended size: 2400 x 860 px. Minimum: 1200 x 430 px.</p></div>
    <label>Slide Label<input name="label" placeholder="Coming Soon" /></label>
    <label>Heading<input name="title" required placeholder="Slide heading" /></label>
    <label class="wide">Subheading / Description<textarea name="text" rows="3"></textarea></label>
    <label>Button Text<input name="buttonText" placeholder="Explore" /></label>
    <label>Button Link<input name="buttonLink" placeholder="/product-categories" /></label>
    <label>Sort Order<input name="order" type="number" value="<%= sliderSlides.length + 1 %>" min="0" /></label>
    <label>Status<select name="status"><option>Active</option><option>Inactive</option></select></label>
    <label>Overlay Strength<input name="overlayStrength" type="number" value="0.58" min="0.18" max="0.85" step="0.05" /></label>
    <%- renderImageUploadControl({ label: "Background Image", value: "", valueName: "backgroundImage", fileName: "backgroundUpload", id: "new-product-slide", multiple: false }) %>
    <label class="wide">Mobile Background Image URL<input name="mobileBackgroundImage" placeholder="/images/product-categories/mobile-banner.png" /></label>
    <button class="admin-button" type="submit">Add Slide</button>
  </form>

  <section class="admin-list">
    <% sliderSlides.forEach(function(slide, index) { %>
      <% const previewId = "product-slide-" + slide.id; %>
      <article class="admin-card">
        <form class="admin-form" method="post" action="/admin/product-category-page/slides/<%= slide.id %>" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="cms-section-heading"><h2><%= slide.title %></h2><p class="admin-note">Product banner slide <%= index + 1 %> · <%= slide.status || "Active" %>. Recommended image size: 2400 x 860 px.</p></div>
          <label>Slide Label<input name="label" value="<%= slide.label || '' %>" /></label>
          <label>Heading<input name="title" value="<%= slide.title || '' %>" required /></label>
          <label class="wide">Subheading / Description<textarea name="text" rows="3"><%= slide.text || '' %></textarea></label>
          <label>Button Text<input name="buttonText" value="<%= slide.buttonText || '' %>" /></label>
          <label>Button Link<input name="buttonLink" value="<%= slide.buttonLink || '' %>" /></label>
          <label>Sort Order<input name="order" type="number" value="<%= slide.order || index + 1 %>" min="0" /></label>
          <label>Status<select name="status"><option <%= selected(slide.status, "Active") %>>Active</option><option <%= selected(slide.status, "Inactive") %>>Inactive</option></select></label>
          <label>Overlay Strength<input name="overlayStrength" type="number" value="<%= slide.overlayStrength || 0.58 %>" min="0.18" max="0.85" step="0.05" /></label>
          <%- renderImageUploadControl({ label: "Background Image", value: slide.backgroundImage || "", valueName: "backgroundImage", fileName: "backgroundUpload", id: previewId, multiple: false }) %>
          <label class="wide">Mobile Background Image URL<input name="mobileBackgroundImage" value="<%= slide.mobileBackgroundImage || slide.mobileImage || '' %>" /></label>
          <button class="admin-button" type="submit">Save Slide</button>
        </form>
        <form class="admin-actions" method="post" action="/admin/product-category-page/slides/<%= slide.id %>/delete">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="admin-button danger" type="submit">Delete Slide</button>
        </form>
      </article>
    <% }) %>
    <% if (!sliderSlides.length) { %><article class="admin-card"><p class="admin-note">No product slider slides yet. Add one above.</p></article><% } %>
  </section>
<% } %>

<% if (kind === "users") { %>
  <form class="admin-card admin-form compact" method="post" action="/admin/users">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="cms-section-heading"><h2>Create User</h2><p class="admin-note">Keep role access controlled; passwords must be at least 10 characters.</p></div>
    <label>Name<input name="name" required /></label><label>Email<input name="email" type="email" required /></label><label>Password<input name="password" type="password" minlength="10" required /></label><label>Role<select name="role"><% roles.forEach(function(role) { %><option><%= role %></option><% }) %></select></label><label>Status<select name="status"><option>Active</option><option>Blocked</option></select></label>
    <button class="admin-button" type="submit">Create User</button>
  </form>
  <section class="admin-list">
    <% state.users.forEach(function(user) { %>
      <form class="admin-card admin-form compact" method="post" action="/admin/users/<%= user.id %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label>Name<input name="name" value="<%= user.name %>" /></label><label>Email<input value="<%= user.email %>" disabled /></label><label>New Password<input name="password" type="password" minlength="10" placeholder="Leave blank to keep" /></label><label>Role<select name="role"><% roles.forEach(function(role) { %><option <%= selected(user.role, role) %>><%= role %></option><% }) %></select></label><label>Status<select name="status"><option <%= selected(user.status, "Active") %>>Active</option><option <%= selected(user.status, "Blocked") %>>Blocked</option></select></label>
        <button class="admin-button" type="submit">Save User</button>
      </form>
    <% }) %>
  </section>
<% } %>

<% if (kind === "messages") { %>
  <%
    const contacts = (submissions.contacts && submissions.contacts.length) ? submissions.contacts : state.inquiries;
    const dealers = submissions.dealerInquiries || [];
    const wholesale = submissions.wholesaleInquiries || [];
  %>
  <section class="admin-grid">
    <article class="admin-card">
      <div class="cms-section-heading"><h2>Contact Messages</h2><p class="admin-note">Customer and general contact form submissions.</p></div>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Subject</th><th>Date</th><th>Status</th><th>Action</th></tr></thead>
          <tbody>
            <% contacts.forEach(function(item) { %>
              <tr>
                <td><strong><%= item.name || item.email || "Visitor" %></strong></td>
                <td><%= item.email || "" %></td>
                <td><%= item.phone || "" %></td>
                <td><%= item.subject || "General inquiry" %></td>
                <td><%= item.createdAt ? new Date(item.createdAt).toLocaleString() : "" %></td>
                <td><span class="pill status-<%= inquiryStatus(item.status).toLowerCase() %>"><%= inquiryStatus(item.status) %></span></td>
                <td><%- include("partials/inquiry-actions", {
                  item,
                  type: "contact",
                  fields: [
                    ["Name", item.name],
                    ["Email", item.email],
                    ["Phone", item.phone],
                    ["Subject", item.subject],
                    ["Message", item.message],
                    ["Submitted At", item.createdAt ? new Date(item.createdAt).toLocaleString() : ""],
                    ["IP Address", item.ip]
                  ]
                }) %></td>
              </tr>
            <% }) %>
            <% if (!contacts.length) { %><tr><td colspan="7">No contact messages yet.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </article>

    <article class="admin-card">
      <div class="cms-section-heading"><h2>Dealer Inquiries</h2><p class="admin-note">Business, dealership, and distributor form submissions.</p></div>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead><tr><th>Name</th><th>Business</th><th>Email</th><th>Phone</th><th>City / State</th><th>Date</th><th>Status</th><th>Action</th></tr></thead>
          <tbody>
            <% dealers.forEach(function(item) { %>
              <tr>
                <td><strong><%= item.name %></strong></td>
                <td><%= item.businessName || item.shop || item.businessType || "" %></td>
                <td><%= item.email || "" %></td>
                <td><%= item.phone || "" %></td>
                <td><%= item.city || "" %><%= item.state ? ", " + item.state : "" %></td>
                <td><%= item.createdAt ? new Date(item.createdAt).toLocaleString() : "" %></td>
                <td><span class="pill status-<%= inquiryStatus(item.status).toLowerCase() %>"><%= inquiryStatus(item.status) %></span></td>
                <td><%- include("partials/inquiry-actions", {
                  item,
                  type: "dealer",
                  fields: [
                    ["Name", item.name],
                    ["Business Name", item.businessName || item.shop],
                    ["Email", item.email],
                    ["Phone", item.phone],
                    ["City", item.city],
                    ["State", item.state],
                    ["Address", item.address],
                    ["Business Type", item.businessType || item.business],
                    ["Message", item.message],
                    ["Submitted At", item.createdAt ? new Date(item.createdAt).toLocaleString() : ""],
                    ["IP Address", item.ip]
                  ]
                }) %></td>
              </tr>
            <% }) %>
            <% if (!dealers.length) { %><tr><td colspan="8">No dealer inquiries yet.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </article>

    <article class="admin-card">
      <div class="cms-section-heading"><h2>Wholesale Inquiries</h2><p class="admin-note">Bulk order and wholesale product requests.</p></div>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead><tr><th>Name</th><th>Business</th><th>Email</th><th>Phone</th><th>Product / Quantity</th><th>Date</th><th>Status</th><th>Action</th></tr></thead>
          <tbody>
            <% wholesale.forEach(function(item) { %>
              <tr>
                <td><strong><%= item.name %></strong></td>
                <td><%= item.businessName || "" %></td>
                <td><%= item.email || "" %></td>
                <td><%= item.phone || "" %></td>
                <td><%= item.productInterest || "" %><%= item.quantityRequirement ? " / " + item.quantityRequirement : "" %></td>
                <td><%= item.createdAt ? new Date(item.createdAt).toLocaleString() : "" %></td>
                <td><span class="pill status-<%= inquiryStatus(item.status).toLowerCase() %>"><%= inquiryStatus(item.status) %></span></td>
                <td><%- include("partials/inquiry-actions", {
                  item,
                  type: "wholesale",
                  fields: [
                    ["Name", item.name],
                    ["Business Name", item.businessName],
                    ["Email", item.email],
                    ["Phone", item.phone],
                    ["Product Interest", item.productInterest],
                    ["Quantity Requirement", item.quantityRequirement],
                    ["Message", item.message],
                    ["Submitted At", item.createdAt ? new Date(item.createdAt).toLocaleString() : ""],
                    ["IP Address", item.ip]
                  ]
                }) %></td>
              </tr>
            <% }) %>
            <% if (!wholesale.length) { %><tr><td colspan="8">No wholesale inquiries yet.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </article>
  </section>
<% } %>

<% if (kind === "newsletter") { %>
  <% const subscribers = (submissions.newsletter && submissions.newsletter.length) ? submissions.newsletter : state.subscribers; %>
  <section class="admin-card">
    <div class="cms-section-heading">
      <h2>Newsletter Subscribers</h2>
      <p class="admin-note">Emails collected through the public newsletter form.</p>
    </div>
    <div class="admin-actions"><a class="admin-button" href="/admin/backup/subscribers.csv">Export CSV</a></div>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead><tr><th>Email</th><th>Status</th><th>Date Subscribed</th></tr></thead>
        <tbody>
          <% subscribers.forEach(function(item) { %><tr><td><strong><%= item.email %></strong></td><td><span class="pill"><%= item.status || "Subscribed" %></span></td><td><%= item.createdAt ? new Date(item.createdAt).toLocaleString() : "" %></td></tr><% }) %>
          <% if (!subscribers.length) { %><tr><td colspan="3">No subscribers yet.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </section>
<% } %>

<% if (kind === "analytics") { %>
  <% const analytics = state.analytics || {}; %>
  <section class="metric-grid">
    <article><span>Page Visits</span><strong><%= analytics.visits || 0 %></strong></article>
    <article><span>Blog Views</span><strong><%= analytics.blogViews || 0 %></strong></article>
    <article><span>Product Clicks</span><strong><%= analytics.productViews || 0 %></strong></article>
    <article><span>QR Clicks</span><strong><%= analytics.qrClicks || 0 %></strong></article>
    <article><span>WhatsApp Clicks</span><strong><%= analytics.whatsappClicks || 0 %></strong></article>
  </section>
  <section class="admin-card">
    <div class="cms-section-heading"><h2>Inquiry Count</h2><p class="admin-note">Contact, dealer, wholesale, and newsletter signals.</p></div>
    <div class="bar-chart">
      <% [
        ["Contact Submissions", (submissions.contacts || state.inquiries || []).length],
        ["Dealer Inquiries", (submissions.dealerInquiries || []).length],
        ["Wholesale Inquiries", (submissions.wholesaleInquiries || []).length],
        ["Newsletter Subscribers", (submissions.newsletter || state.subscribers || []).length]
      ].forEach(function(row) { const width = Math.max(8, Math.min(100, Number(row[1] || 0) * 14)); %>
        <div><span><%= row[0] %></span><i style="width:<%= width %>%"></i><b><%= row[1] %></b></div>
      <% }) %>
    </div>
  </section>
<% } %>

<% if (kind === "blog") { %>
  <form class="admin-card admin-form compact" method="post" action="/admin/blog" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="cms-section-heading"><h2>Add Blog Post</h2><p class="admin-note">Blog content for ZUPPIO stories, snack ideas, recipes, and launches.</p></div>
    <label>Blog Title<input name="title" required /></label>
    <label>Slug<input name="slug" required /></label>
    <label>Category<input name="category" /></label>
    <label>Tags<input name="tags" placeholder="snacks, recipes" /></label>
    <label>Status<select name="status"><option>Draft</option><option>Published</option><option>Unpublished</option></select></label>
    <%- renderImageUploadControl({ label: "Blog Image", value: "", valueName: "image", fileName: "blogImage", id: "new-blog-image", multiple: false }) %>
    <label class="wide">Short Description<textarea name="description" rows="3"></textarea></label>
    <label class="wide">Full Blog Content<textarea name="content" rows="8"></textarea></label>
    <label class="wide">SEO Title<input name="seoTitle" /></label>
    <label class="wide">SEO Description<textarea name="seoDescription" rows="3"></textarea></label>
    <button class="admin-button" type="submit">Add Blog Post</button>
  </form>
  <section class="admin-list">
    <% state.blogPosts.forEach(function(post) { %>
      <article class="admin-card">
        <form class="admin-form compact" method="post" action="/admin/blog/<%= post.id %>" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="cms-section-heading"><h2><%= post.title %></h2><p class="admin-note"><%= post.category %> · <%= post.status %></p></div>
          <label>Blog Title<input name="title" value="<%= post.title %>" /></label>
          <label>Slug<input name="slug" value="<%= post.slug %>" /></label>
          <label>Category<input name="category" value="<%= post.category %>" /></label>
          <label>Tags<input name="tags" value="<%= list(post.tags) %>" /></label>
          <label>Status<select name="status"><option <%= selected(post.status, "Draft") %>>Draft</option><option <%= selected(post.status, "Published") %>>Published</option><option <%= selected(post.status, "Unpublished") %>>Unpublished</option></select></label>
          <%- renderImageUploadControl({ label: "Blog Image", value: post.image || "", valueName: "image", fileName: "blogImage", id: "blog-image-" + post.id, multiple: false }) %>
          <label class="wide">Short Description<textarea name="description" rows="3"><%= post.description %></textarea></label>
          <label class="wide">Full Blog Content<textarea name="content" rows="8"><%= Array.isArray(post.content) ? post.content.join('\n\n') : (post.content || '') %></textarea></label>
          <label class="wide">SEO Title<input name="seoTitle" value="<%= post.seoTitle || '' %>" /></label>
          <label class="wide">SEO Description<textarea name="seoDescription" rows="3"><%= post.seoDescription || '' %></textarea></label>
          <button class="admin-button" type="submit">Save Blog</button>
        </form>
        <form class="admin-actions" method="post" action="/admin/blog/<%= post.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="admin-button danger" type="submit">Delete Blog</button></form>
      </article>
    <% }) %>
  </section>
<% } %>

<% if (kind === "faqs") { %>
  <% const faqLocations = ["Homepage", "Product Page", "How To Buy", "Contact"]; %>
  <form class="admin-card admin-form compact" method="post" action="/admin/faqs">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="cms-section-heading"><h2>Add FAQ</h2><p class="admin-note">FAQs can be assigned to homepage, product pages, How To Buy, or Contact.</p></div>
    <label>Order<input name="order" type="number" /></label>
    <label>Page Location<select name="pageLocation"><% faqLocations.forEach(function(location) { %><option><%= location %></option><% }) %></select></label>
    <label>Status<select name="status"><option>Published</option><option>Unpublished</option></select></label>
    <label class="wide">Question<input name="question" required /></label>
    <label class="wide">Answer<textarea name="answer" rows="4"></textarea></label>
    <button class="admin-button" type="submit">Add FAQ</button>
  </form>
  <section class="admin-list">
    <% state.faqs.forEach(function(faq) { %>
      <article class="admin-card">
        <form class="admin-form compact" method="post" action="/admin/faqs/<%= faq.id %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <label>Order<input name="order" type="number" value="<%= faq.order %>" /></label>
          <label>Page Location<select name="pageLocation"><% faqLocations.forEach(function(location) { %><option <%= selected(faq.pageLocation || "Homepage", location) %>><%= location %></option><% }) %></select></label>
          <label>Status<select name="status"><option <%= selected(faq.status || "Published", "Published") %>>Published</option><option <%= selected(faq.status, "Unpublished") %>>Unpublished</option></select></label>
          <label class="wide">Question<input name="question" value="<%= faq.question %>" /></label>
          <label class="wide">Answer<textarea name="answer" rows="4"><%= faq.answer %></textarea></label>
          <button class="admin-button" type="submit">Save FAQ</button>
        </form>
        <form class="admin-actions" method="post" action="/admin/faqs/<%= faq.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="admin-button danger" type="submit">Delete FAQ</button></form>
      </article>
    <% }) %>
  </section>
<% } %>

<% if (kind === "settings") { %>
  <% const status = typeof envStatus !== "undefined" ? envStatus : { googleMaps: false, smtp: false }; %>
  <section class="admin-grid two">
    <article class="admin-card">
      <div class="cms-section-heading"><h2>Integration Status</h2><p class="admin-note">Environment-based services are shown as status only and are not exposed as raw secret values.</p></div>
      <p><strong>Google Maps API</strong> <span class="pill"><%= status.googleMaps ? "Configured" : "Missing" %></span></p>
      <p><strong>SMTP</strong> <span class="pill"><%= status.smtp ? "Configured" : "Missing" %></span></p>
      <p><strong>MongoDB Atlas</strong> <span class="pill"><%= status.mongodb ? "Configured" : "Missing" %></span></p>
    </article>
    <article class="admin-card">
      <div class="cms-section-heading"><h2>Core Settings</h2><p class="admin-note">Website name, admin email, contact email, default WhatsApp number, and public brand defaults.</p></div>
      <form class="admin-form" method="post" action="/admin/settings">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <% Object.keys(state.settings).forEach(function(key) { %><label><%= key %><input name="<%= key %>" value="<%= state.settings[key] %>" /></label><% }) %>
        <button class="admin-button" type="submit">Save Settings</button>
      </form>
    </article>
  </section>
<% } %>

<% if (kind === "audit") { %>
  <section class="admin-card audit-table">
    <div class="cms-section-heading"><h2>Audit Logs</h2><p class="admin-note">Recorded admin activity.</p></div>
    <% state.auditLogs.forEach(function(log) { %><p><strong><%= log.action %></strong><span><%= log.actor %></span><span><%= log.target %></span><span><%= new Date(log.createdAt).toLocaleString() %></span></p><% }) %>
  </section>
<% } %>

<%- include("partials/shell-close") %>

<%- include("partials/header") %>

<%- include("partials/page-hero", { pageHero: policiesConfig.hero }) %>

<section class="terms-section" aria-label="Terms policy categories">
  <div class="policy-grid">
    <% policies.forEach(function(policy, index) { %>
      <a class="policy-card scroll-reveal" href="/terms/<%= policy.slug %>" style="--delay: <%= index * 60 %>ms">
        
        <h2><%= policy.title %></h2>
        <p><%= policy.preview %></p>
        <span class="policy-open">Open policy</span>
      </a>
  <% }) %>
  </div>
</section>

<%- include("partials/footer") %>

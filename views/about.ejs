<%- include("partials/header") %>

<%- include("partials/page-hero", { pageHero: aboutPage.hero }) %>

<section class="section about-intro">
  <div class="about-copy-card scroll-reveal">
    <p class="eyebrow"><%= aboutPage.intro.label %></p>
    <h2><%= aboutPage.intro.title %></h2>
    <% aboutPage.intro.paragraphs.forEach(function(paragraph) { %><p><%= paragraph %></p><% }) %>
  </div>

  <div class="about-pack-stage scroll-reveal" style="--delay: 120ms" aria-label="ZUPPIO product visual">
    <div class="packet-glow"></div>
    <img class="about-pack" src="<%= aboutPage.intro.image %>" alt="ZUPPIO product visual" />
  </div>
</section>

<section class="section about-split">
  <div class="about-story-card scroll-reveal">
    <p class="eyebrow"><%= aboutPage.whoWeAre.label %></p>
    <h2><%= aboutPage.whoWeAre.title %></h2>
    <% aboutPage.whoWeAre.paragraphs.forEach(function(paragraph) { %><p><%= paragraph %></p><% }) %>
  </div>

  <div class="about-feature-grid">
    <% aboutPage.whoWeAre.featureCards.forEach(function(card, index) { %>
      <article class="glass-card scroll-reveal" style="--delay: <%= (index + 1) * 80 %>ms">
        <i data-lucide="<%= card.icon %>"></i>
        <h3><%= card.title %></h3>
        <p><%= card.text %></p>
      </article>
    <% }) %>
  </div>
</section>

<section class="section about-story-section">
  <div class="about-timeline scroll-reveal">
    <p class="eyebrow"><%= aboutPage.story.label %></p>
    <h2><%= aboutPage.story.title %></h2>
    <p class="about-quote"><%= aboutPage.story.quote %></p>
    <% aboutPage.story.paragraphs.forEach(function(paragraph) { %><p><%= paragraph %></p><% }) %>
  </div>
</section>

<section class="section mission-vision-grid">
  <article class="mission-card scroll-reveal">
    <p class="eyebrow"><%= aboutPage.mission.label %></p>
    <h2><%= aboutPage.mission.title %></h2>
    <p><%= aboutPage.mission.text %></p>
  </article>

  <article class="mission-card vision-card scroll-reveal" style="--delay: 120ms">
    <p class="eyebrow"><%= aboutPage.vision.label %></p>
    <h2><%= aboutPage.vision.title %></h2>
    <p><%= aboutPage.vision.text %></p>
  </article>
</section>

<section class="section about-values-section">
  <div class="section-kicker">
    <p class="eyebrow"><%= aboutPage.values.label %></p>
    <h2><%= aboutPage.values.title %></h2>
  </div>

  <div class="values-grid">
    <% aboutPage.values.cards.forEach(function(card, index) { %>
      <article class="glass-card value-card scroll-reveal" style="--delay: <%= index * 80 %>ms">
        <i data-lucide="<%= card.icon %>"></i>
        <h3><%= card.title %></h3>
        <p><%= card.text %></p>
      </article>
    <% }) %>
  </div>
</section>

<%- include("partials/footer") %>

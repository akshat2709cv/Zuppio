<%- include("partials/header") %>

<section class="product-suggestion-section">
  <div class="swiper product-suggestion-swiper">
    <div class="swiper-wrapper">
      <article class="swiper-slide product-suggestion-slide category-hero-slide">
        <% const responsiveBanner = (typeof responsiveSwiperSlides !== "undefined" && responsiveSwiperSlides[0]) ? responsiveSwiperSlides[0] : {
          desktopImage: "/images/product-categories/zuppio-category-desktop.png",
          tabletImage: "/images/product-categories/zuppio-category-tablet.png",
          mobileImage: "/images/product-categories/zuppio-category-mobile.png",
          alt: "ZUPPIO product category city illustration"
        }; %>
        <picture>
          <source media="(max-width: 640px)" srcset="<%= responsiveBanner.mobileImage %>" />
          <source media="(max-width: 1024px)" srcset="<%= responsiveBanner.tabletImage %>" />
          <img
            src="<%= responsiveBanner.desktopImage %>"
            alt="<%= responsiveBanner.alt %>"
            width="1232"
            height="864"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </article>

      <% productCategoryPage.suggestionSlides.forEach(function(slide) { %>
        <article class="swiper-slide product-suggestion-slide <%= slide.className %>">
          <div class="product-suggestion-copy">
            <p class="eyebrow"><%= slide.label %></p>
            <h2><%= slide.title %></h2>
            <p><%= slide.text %></p>
            <a class="button secondary" href="<%= slide.buttonLink %>">
              <%= slide.buttonText %>
              <i data-lucide="arrow-right"></i>
            </a>
          </div>
          <div class="product-suggestion-art <%= slide.artClass %>" aria-hidden="true">
            <% slide.images.forEach(function(image) { %><img src="<%= image %>" alt="" /><% }) %>
          </div>
        </article>
      <% }) %>
    </div>

    <button class="suggestion-arrow suggestion-prev" type="button" aria-label="Previous product suggestion">
      <i data-lucide="chevron-left"></i>
    </button>
    <button class="suggestion-arrow suggestion-next" type="button" aria-label="Next product suggestion">
      <i data-lucide="chevron-right"></i>
    </button>
    <div class="swiper-pagination suggestion-pagination"></div>
  </div>
</section>

<section class="section category-overview-section">
  <div class="section-kicker">
    <p class="eyebrow"><%= productCategoryPage.overview.label %></p>
    <h2><%= productCategoryPage.overview.title %></h2>
  </div>

  <div class="category-grid">
    <% productCategories.forEach(function(category, index) { %>
      <article class="category-card scroll-reveal" id="<%= category.id %>" style="--delay: <%= index * 70 %>ms">
        <span class="category-status <%= category.status === 'Available' ? 'available' : '' %>"><%= category.status %></span>
        <img class="category-image" src="<%= category.image %>" alt="<%= category.name %> category" />
        <div>
          <h2><%= category.name %></h2>
          <p><%= category.summary %></p>
        </div>
        <button class="category-menu-toggle" type="button" aria-label="Show <%= category.name %> products" aria-expanded="false">
          <i data-lucide="ellipsis"></i>
        </button>
        <div class="category-product-menu" hidden>
          <% category.groups.forEach(function(group) { %>
            <div class="product-group">
              <h3><%= group.name %></h3>
              <div class="product-pill-grid">
                <% group.products.forEach(function(product) { %>
                  <div class="product-pill <%= product.status === 'Available' ? 'available' : '' %>">
                    <% if (product.image) { %>
                      <img src="<%= product.image %>" alt="<%= product.name %> pack" />
                    <% } else { %>
                      <span class="product-dot" aria-hidden="true"></span>
                    <% } %>
                    <div>
                      <strong><%= product.name %></strong>
                      <small><%= product.status %></small>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          <% }) %>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<section class="section">
  <div class="product-contact-panel scroll-reveal">
    <div>
      <p class="eyebrow"><%= productCategoryPage.businessPanel.label %></p>
      <h2><%= productCategoryPage.businessPanel.title %></h2>
      <p><%= productCategoryPage.businessPanel.text %></p>
    </div>
    <a class="button primary" href="<%= productCategoryPage.businessPanel.buttonLink %>">
      <%= productCategoryPage.businessPanel.buttonText %>
      <i data-lucide="message-circle"></i>
    </a>
  </div>
</section>

<%- include("partials/footer") %>

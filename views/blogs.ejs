<%- include("partials/header") %>

<%- include("partials/page-hero") %>

<section class="section blog-grid">
  <% managedBlogPosts.forEach(function(blog, index) { %>
    <a class="blog-card glass-card scroll-reveal flavor-<%= ["purple", "yellow", "green"][index % 3] %>" href="/blogs/<%= blog.slug %>" style="--delay: <%= index * 90 %>ms">
      <img src="<%= blog.image || '/images/home-hero-zuppio.png' %>" alt="<%= blog.title %>" />
      <h2><%= blog.title %></h2>
      <strong class="blog-read-more">
        Read More
        <i data-lucide="arrow-up-right"></i>
      </strong>
    </a>
  <% }) %>
  <% if (!managedBlogPosts.length) { %>
    <article class="blog-card glass-card scroll-reveal flavor-purple">
      <h2>No posts yet</h2>
    </article>
  <% } %>
</section>

<%- include("partials/footer") %>

<%- include("partials/header") %>

<div class="terms-page shared-snack-hero-wrap">
  <%- include("partials/snack-page-hero", {
    snackHero: {
      id: "contact-page-title",
      breadcrumbTitle: contactPage.hero.breadcrumbTitle,
      commandTitle: contactPage.hero.commandTitle,
      pageTitle: contactPage.hero.pageTitle,
      intro: "Connect with the ZUPPIO team for customer support, products, retail, distribution, and business enquiries.",
      badgesLabel: "Contact options",
      badges: [
        { icon: "headphones", label: "Helpful\nSupport" },
        { icon: "message-circle", label: "WhatsApp\nReady" },
        { icon: "handshake", label: "Business\nEnquiries" }
      ]
    }
  }) %>
</div>

<section class="section contact-details-section">
  <div class="contact-info-panel scroll-reveal">
    <p class="eyebrow">Company Information</p>
    <h2><%= contactPage.companyName %></h2>

    <div class="contact-info-list">
      <article>
        <i data-lucide="map-pin"></i>
        <span>Office Address</span>
        <p><%= contactPage.address %></p>
      </article>
      <article>
        <i data-lucide="phone"></i>
        <span>Phone Number</span>
        <p><a href="tel:<%= contactPage.phone.replace(/\s/g, '') %>"><%= contactPage.phone %></a></p>
      </article>
      <article>
        <i data-lucide="mail"></i>
        <span>Email Address</span>
        <p><a href="mailto:<%= contactPage.email %>"><%= contactPage.email %></a></p>
      </article>
    </div>
  </div>

  <div class="contact-action-panel">
    <div class="whatsapp-card scroll-reveal" style="--delay: 120ms">
      <p class="eyebrow">WhatsApp Contact</p>
      <h2><%= contactPage.whatsappTitle %></h2>
      
      <a class="button primary" href="<%= contactPage.whatsappLink %>" target="_blank" rel="noopener noreferrer">
        <%= contactPage.whatsappButtonText %>
        <i data-lucide="message-circle"></i>
      </a>
    </div>

    <div class="contact-social-card scroll-reveal" style="--delay: 200ms">
      <p class="eyebrow">Social Media</p>
      <div class="contact-social-links">
        <% contactPage.socialCards.filter(function(item) { return item.visible !== false; }).forEach(function(item) { %>
          <a href="<%= item.url %>" target="_blank" rel="noopener noreferrer" aria-label="Open ZUPPIO <%= item.label %>">
            <img src="<%= item.icon %>" alt="" />
            <span><%= item.label %></span>
          </a>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<section class="section qr-section">
  <div class="section-kicker">
    <p class="eyebrow">QR Access</p>
    <h2>Scan and connect instantly.</h2>
  </div>

  <div class="qr-grid">
    <% contactPage.qrCards.forEach(function(card, index) { %>
      <article class="qr-card scroll-reveal" style="--delay: <%= index * 100 %>ms">
        <h3><%= card.title %></h3>
        <img src="<%= card.image %>" alt="<%= card.title %> QR code" />
        <a href="<%= card.link %>" target="_blank" rel="noopener noreferrer"><%= card.buttonText %></a>
      </article>
    <% }) %>
  </div>
</section>

<section class="section contact-form-section">
  <div class="contact-form-heading">
    <p class="eyebrow"><%= contactPage.formHeading.label %></p>
    <h2><%= contactPage.formHeading.title %></h2>
  </div>

  <form class="form-card wide contact-message-form scroll-reveal" action="/contact" method="POST">
    <div class="form-field">
      <label for="contact-name">Name</label>
      <input id="contact-name" name="name" type="text" placeholder="Your name" autocomplete="name" required />
    </div>

    <div class="form-field">
      <label for="contact-email">Email</label>
      <input id="contact-email" name="email" type="email" placeholder="you@crunch.in" autocomplete="email" required />
    </div>

    <div class="form-field">
      <label for="contact-phone">Phone (optional)</label>
      <input id="contact-phone" name="phone" type="tel" inputmode="tel" placeholder="Phone number" autocomplete="tel" />
    </div>

    <div class="form-field">
      <label for="contact-subject">Subject (optional)</label>
      <input id="contact-subject" name="subject" type="text" placeholder="How can we help?" />
    </div>

    <div class="form-field full">
      <label for="contact-message">Message</label>
      <textarea id="contact-message" name="message" placeholder="Tell us what you want to know..." required></textarea>
    </div>

    <button class="button primary" type="submit">
      Send Message
      <i data-lucide="send"></i>
    </button>
    <p class="newsletter-status" aria-live="polite"></p>
  </form>
</section>

<%- include("partials/footer") %>

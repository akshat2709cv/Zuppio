<%- include("partials/header") %>

<section class="page-hero">
  <p class="eyebrow">How To Buy</p>
  <h1>Deal with us directly.</h1>
  <p>For wholesalers, distributors, and shop owners.</p>
</section>

<section class="section split">
  <div class="glass-card wholesale-card scroll-reveal">
    <h2>Wholesale Benefits</h2>
    <ul>
      <li>Direct company pricing</li>
      <li>Fast delivery</li>
      <li>Distributor support</li>
      <li>Exclusive offers</li>
    </ul>
  </div>

  <form class="form-card scroll-reveal" style="--delay: 120ms">
    <div class="form-field">
      <label for="buyer-name">Name</label>
      <input id="buyer-name" name="name" placeholder="Your name" autocomplete="name" />
    </div>
    <div class="form-field">
      <label for="shop-name">Shop</label>
      <input id="shop-name" name="shop" placeholder="Shop name" />
    </div>
    <div class="form-field">
      <label for="buyer-phone">Phone</label>
      <input id="buyer-phone" name="phone" placeholder="Phone number" autocomplete="tel" />
    </div>
    <div class="form-field">
      <label for="buyer-city">City</label>
      <input id="buyer-city" name="city" placeholder="City" autocomplete="address-level2" />
    </div>
    <div class="form-field">
      <label for="business-type">Business</label>
      <input id="business-type" name="business" placeholder="Business type" />
    </div>
    <div class="form-field">
      <label for="quantity">Quantity</label>
      <input id="quantity" name="quantity" placeholder="Quantity requirement" />
    </div>
    <button class="button primary" type="submit">
      Submit Inquiry
      <i data-lucide="send"></i>
    </button>
  </form>
</section>

<%- include("partials/footer") %>

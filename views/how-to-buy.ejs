<%- include("partials/header") %>

<%- include("partials/page-hero", { pageHero: howToBuyPage.hero }) %>

<section class="section split">
  <div class="glass-card wholesale-card scroll-reveal">
    <h2><%= howToBuyPage.benefitsTitle %></h2>
    <ul>
      <% howToBuyPage.benefits.forEach(function(benefit) { %><li><%= benefit %></li><% }) %>
    </ul>
  </div>

  <form class="form-card dealer-inquiry-form scroll-reveal" action="/dealer-inquiries" method="POST" style="--delay: 120ms">
    <% howToBuyPage.formFields.forEach(function(field) { %>
      <div class="form-field">
        <label for="buyer-<%= field.name %>"><%= field.label %></label>
        <input id="buyer-<%= field.name %>" name="<%= field.name %>" placeholder="<%= field.placeholder %>" <%= field.required ? "required" : "" %> />
      </div>
    <% }) %>
    <button class="button primary" type="submit">
      <%= howToBuyPage.submitButtonText %>
      <i data-lucide="send"></i>
    </button>
    <p class="newsletter-status" aria-live="polite"></p>
  </form>
</section>

<%- include("partials/footer") %>

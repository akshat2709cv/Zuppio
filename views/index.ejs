    },
    {
      name: "Italian Tadka Potato Chips",
      image: "/images/product-categories/italian-tadka-3d.png",
      price: "₹20.00",
      comparePrice: "₹25.00"
    },
    {
      name: "ZUPcereal Banana Chips (Thin)",
      image: "/images/product-categories/salted-banana-chips.png",
      price: "₹20.00",
      comparePrice: "₹25.00"
    },
    {
      name: "Zuberto Cookies (150g)",
      image: "/images/product-categories/biscuit-cookies-card.png",
      price: "₹20.00",
      comparePrice: "₹25.00"
    }
  ];

  const heroTrustItems = [
    {
      icon: "sprout",
      title: "Premium Ingredients",
      text: "Carefully sourced for perfect taste & quality."
    },
    {
      icon: "package-check",
      title: "Hygienic Packaging",
      text: "Sealed for freshness and safety you can trust."
    },
    {
      icon: "layout-grid",
      title: "Wide Product Range",
      text: "Something tasty for every mood."
    },
    {
      icon: "heart-handshake",
      title: "Loved Across India",

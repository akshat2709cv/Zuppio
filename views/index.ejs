<%- include("partials/header") %>

<section class="hero home-hero" id="home">
  <div class="hero-ambient" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </div>

  <div class="hero-content scroll-reveal">
    <p class="eyebrow"><%= homepage.hero.label %></p>
    <h1><%= homepage.hero.title %></h1>
    <p><%= homepage.hero.subtitle %></p>
    <div class="hero-actions">
      <a class="button primary" href="<%= homepage.hero.primaryButtonLink %>">
        <%= homepage.hero.primaryButtonText %>
        <i data-lucide="arrow-right"></i>
      </a>
      <a class="button secondary" href="<%= homepage.hero.secondaryButtonLink %>">
        <%= homepage.hero.secondaryButtonText %>
        <i data-lucide="message-circle"></i>
      </a>
    </div>
  </div>

  <div class="hero-product-stage scroll-reveal" style="--delay: 120ms">
    <div class="packet-glow"></div>
    <img class="hero-pack hero-pack-main" src="<%= homepage.hero.mainImage %>" alt="ZUPPIO hero product" data-depth="0.08" />
    <img class="hero-pack hero-pack-left" src="<%= homepage.hero.leftImage %>" alt="" data-depth="0.04" />
    <img class="hero-pack hero-pack-right" src="<%= homepage.hero.rightImage %>" alt="" data-depth="0.06" />
    <span class="particle particle-one"></span>
    <span class="particle particle-two"></span>
    <span class="particle particle-three"></span>
  </div>
</section>

<section class="section about-preview" id="about">
  <div class="section-kicker">
    <p class="eyebrow"><%= homepage.aboutPreview.label %></p>
    <h2><%= homepage.aboutPreview.title %></h2>
  </div>

  <div class="about-mini-grid">
    <% homepage.aboutPreview.cards.forEach(function(card, index) { %>
      <article class="glass-card scroll-reveal" style="--delay: <%= index * 90 %>ms">
        <i data-lucide="<%= card.icon %>"></i>
        <h3><%= card.title %></h3>
        <p><%= card.text %></p>
      </article>
    <% }) %>
  </div>
</section>

<section class="section flavor-slider-section" id="flavors">
  <div class="section-kicker">
    <p class="eyebrow"><%= homepage.categoryShowcase.label %></p>
    <h2><%= homepage.categoryShowcase.title %></h2>
  </div>

  <div class="product-marquee" aria-label="ZUPPIO product category showcase">
    <div class="product-marquee-track">
      <% [false, true].forEach(function(isDuplicate) { %>
        <div class="product-marquee-set" <%= isDuplicate ? 'aria-hidden="true"' : "" %>>
          <% homepage.categoryShowcase.cards.forEach(function(category) { %>
            <article class="marquee-product-card category-marquee-card flavor-<%= category.color %>">
              <% if (category.status && category.status.toLowerCase().includes("coming")) { %>
                <span class="badge future-badge"><%= category.badge || "Future Expansion" %></span>
              <% } else { %>
                <span class="badge available-badge"><%= category.badge || category.status %></span>
              <% } %>
              <div class="chips-pattern" aria-hidden="true"></div>
              <img class="marquee-category-icon" src="<%= category.image %>" alt="<%= isDuplicate ? "" : category.name + " category icon" %>" />
              <div class="marquee-product-copy">
                <p class="eyebrow"><%= category.status %></p>
                <h3><%= category.name %></h3>
                <p><%= category.description %></p>
                <a class="button secondary" href="<%= category.id ? ('/product-categories/' + category.id) : (category.link || '/product-categories') %>">
                  Explore Category
                  <i data-lucide="arrow-right"></i>
                </a>
              </div>
            </article>
          <% }) %>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section testimonials-section">
  <div class="section-kicker">
    <p class="eyebrow"><%= homepage.testimonials.label %></p>
    <h2><%= homepage.testimonials.title %></h2>
  </div>
  <div class="swiper testimonial-swiper">
    <div class="swiper-wrapper">
      <% homepage.testimonials.items.forEach(function(item) { %>
        <article class="swiper-slide testimonial-card">
          <p><%= item.quote %></p>
          <span><%= item.author %></span>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<section class="section faq-section">
  <%
    const faqItems = homepage.faqs.items || [];
    const faqPreviewLimit = 3;
    const hasMoreFaqs = faqItems.length > faqPreviewLimit;
  %>
  <div class="section-kicker">
    <p class="eyebrow"><%= homepage.faqs.label %></p>
    <h2><%= homepage.faqs.title %></h2>
  </div>
  <div class="faq-list">
    <% faqItems.forEach(function(item, index) { %>
      <article class="faq-item <%= index >= faqPreviewLimit ? 'faq-item-extra' : '' %>" <%= index >= faqPreviewLimit ? "hidden" : "" %>>
        <button type="button" aria-expanded="false">
          <span><%= item.question %></span>
          <i data-lucide="chevron-down"></i>
        </button>
        <div class="faq-panel">
          <p><%= item.answer %></p>
        </div>
      </article>
    <% }) %>
  </div>
  <% if (hasMoreFaqs) { %>
    <button class="faq-show-more" type="button" data-faq-show-more aria-label="Show more FAQs" aria-expanded="false">
      <i data-lucide="chevron-down"></i>
    </button>
  <% } %>
</section>

<section class="section newsletter-section">
  <div class="newsletter-panel">
    <div>
      <p class="eyebrow"><%= homepage.newsletter.label %></p>
      <h2><%= homepage.newsletter.title %></h2>
    </div>
    <form class="newsletter-card snack-drop-form" action="/snack-drop-alerts" method="POST">
      <label for="home-email"><%= homepage.newsletter.fieldLabel %></label>
      <div>
        <input id="home-email" name="email" type="email" placeholder="<%= homepage.newsletter.placeholder %>" autocomplete="email" required />
        <button type="submit" aria-label="Subscribe">
          <i data-lucide="arrow-right"></i>
        </button>
      </div>
      <p class="newsletter-status" aria-live="polite"></p>
    </form>
  </div>
</section>

<%- include("partials/footer") %>

<section class="hero home-hero" id="home" style="<%= heroStyle %>">
  <div class="hero-ambient" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </div>

  <div class="hero-content scroll-reveal">
    <p class="eyebrow"><%= homepage.hero.label %></p>
    <h1><%= homepage.hero.title %></h1>
    <p><%= homepage.hero.subtitle %></p>
    <div class="hero-actions">
      <a class="button primary" href="<%= homepage.hero.primaryButtonLink %>">
        <%= homepage.hero.primaryButtonText %>
        <i data-lucide="arrow-right"></i>
      </a>
      <a class="button secondary" href="<%= homepage.hero.secondaryButtonLink %>">
        <%= homepage.hero.secondaryButtonText %>
        <i data-lucide="message-circle"></i>
      </a>
    </div>
  </div>

</section>

<section class="hero-trust-strip" aria-label="ZUPPIO brand highlights">
  <div class="hero-trust-panel">
    <% heroTrustItems.forEach(function(item) { %>
      <article class="hero-trust-item">
        <span class="hero-trust-icon" aria-hidden="true">
          <i data-lucide="<%= item.icon %>"></i>
        </span>
        <span class="hero-trust-copy">
          <strong><%= item.title %></strong>
          <small><%= item.text %></small>
        </span>
      </article>
    <% }) %>
  </div>
</section>

<section class="zuppio-universe" id="flavors" aria-labelledby="zuppioUniverseTitle">
  <div class="zuppio-universe-inner">
    <div class="universe-title-wrap">
      <span class="universe-doodle universe-doodle-left" aria-hidden="true"></span>
      <p>Our Product Universe</p>
      <h2 id="zuppioUniverseTitle">Explore the <span>Zuppio</span> World of Crunch</h2>
      <span class="universe-doodle universe-doodle-right" aria-hidden="true"></span>
    </div>

    <div class="universe-carousel-shell">
      <button class="universe-arrow universe-arrow-left" type="button" aria-label="Previous category">
        <i data-lucide="chevron-left"></i>
      </button>
      <div class="universe-category-grid">
        <% universeCategories.forEach(function(category) { %>
          <a class="universe-category-card universe-category-<%= category.theme %>" href="<%= category.link %>" aria-label="Explore <%= category.name %>">
            <img src="<%= category.image %>" alt="<%= category.name %>" loading="lazy" />
            <strong><%= category.name %></strong>
            <span class="universe-category-cta" aria-hidden="true">
              <i data-lucide="chevron-right"></i>
            </span>
          </a>
        <% }) %>
      </div>
      <button class="universe-arrow universe-arrow-right" type="button" aria-label="Next category">
        <i data-lucide="chevron-right"></i>
      </button>
    </div>

    <div class="bestseller-heading">
      <h3><i data-lucide="flame"></i> Best Sellers</h3>
      <a href="/product-categories">View All Products <i data-lucide="arrow-right"></i></a>
    </div>

    <div class="bestseller-grid">
      <% bestSellers.forEach(function(product) { %>
        <article class="bestseller-card bestseller-card-<%= product.shape || 'chips' %>">
          <a class="bestseller-image" href="/product-categories" aria-label="<%= product.name %>">
            <img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy" />
          </a>
          <div class="bestseller-card-footer">
            <h4><%= product.name %></h4>
            <div class="bestseller-price-row">
              <span><%= product.price %></span>
              <s><%= product.comparePrice %></s>
            </div>
          </div>
          <button class="bestseller-cart" type="button" aria-label="Add <%= product.name %> to cart">
            <i data-lucide="shopping-cart"></i>
          </button>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<%
  const snackMoments = [
    { title: "Movie Night", image: "/images/home/movie-night-zuppio.png" },
    { title: "Tea Time", image: "/images/home/tea-time-zuppio.png" },
    { title: "Travel Buddy", image: "/images/home/travel-buddy-zuppio.png" },
    { title: "Party Time", image: "/images/home/party-time-zuppio.png" },
    { title: "Post Workout", image: "/images/home/post-workout-zuppio.png" }
  ];
  const faqItems = homepage.faqs.items || [];
  const faqPreviewLimit = 4;
%>

<div class="home-story-sections">
  <section class="home-moments-section" aria-labelledby="snackMomentsTitle">
    <div class="home-moments-intro">
      <p>Snack moments,</p>
      <h2 id="snackMomentsTitle">made better.</h2>
      <span>Perfect crunch for every mood and moment.</span>
      <a href="/blogs">Explore Moments <i data-lucide="arrow-right"></i></a>
    </div>
    <div class="home-moment-grid">
      <% snackMoments.forEach(function(moment) { %>
        <a class="home-moment-card" href="/blogs">
          <img src="<%= moment.image %>" alt="<%= moment.title %> snack moment" loading="lazy" />
          <strong><%= moment.title %></strong>
        </a>
      <% }) %>
    </div>
  </section>

  <section class="home-choice-section" aria-labelledby="whyZuppioTitle">
    <div class="home-choice-copy">
      <p><i data-lucide="star"></i> Why choose ZUPPIO?</p>
      <h2 id="whyZuppioTitle">Made with Care. <em>Loved</em> by All.</h2>
      <span class="home-choice-subcopy">From real ingredients to irresistible flavors, every bite is crafted for your perfect snack time.</span>
      <div class="home-choice-feature-grid" aria-label="ZUPPIO quality promises">
        <article>
          <i data-lucide="leaf"></i>
          <strong>Premium Ingredients</strong>
          <span>Selected with care</span>
        </article>
        <article>
          <i data-lucide="shield-check"></i>
          <strong>Hygienic &amp; Safe</strong>
          <span>Quality you trust</span>
        </article>
        <article>
          <i data-lucide="smile"></i>
          <strong>Irresistible Flavors</strong>
          <span>For every mood</span>
        </article>
        <article>
          <i data-lucide="heart"></i>
          <strong>Made for Every Moment</strong>
          <span>Anytime, anywhere</span>
        </article>
      </div>
      <a class="home-choice-cta" href="/about">Discover Zuppio <i data-lucide="arrow-right"></i></a>
    </div>

    <div class="home-choice-visual">
      <img class="home-choice-pack home-choice-pack-yellow" src="/images/yellow.png" alt="ZUPPIO Seedha Simple Aloo Snack pack" loading="lazy" />
      <img class="home-choice-pack home-choice-pack-green" src="/images/green.png" alt="ZUPPIO Italian Tadka Aloo Snack pack" loading="lazy" />
      <img class="home-choice-pack home-choice-pack-purple" src="/images/purple.png" alt="ZUPPIO Mast Masaledar Aloo Snack pack" loading="lazy" />
      <span class="home-choice-quality">Quality<br />You Can<br />Trust</span>
    </div>

    <div class="home-choice-stats" aria-label="ZUPPIO highlights">
      <div>
        <i data-lucide="star"></i>
        <strong>25+</strong>
        <span>Types of Products</span>
        <small>And growing</small>
      </div>
      <div>
        <i data-lucide="users-round"></i>
        <strong>100+</strong>
        <span>Retail Partners</span>
        <small>Across India</small>
      </div>
      <div>
        <i data-lucide="heart"></i>
        <strong>10K+</strong>
        <span>Happy Customers</span>
        <small>And counting</small>
      </div>
    </div>
  </section>

  <section class="home-reviews-section" aria-labelledby="reviewsTitle">
    <div class="home-reviews-heading">
      <p>What snack lovers say</p>
      <h2 id="reviewsTitle">Crunch reviews</h2>
    </div>
    <div class="home-review-grid">
      <% homepage.testimonials.items.forEach(function(item, index) { %>
        <article class="home-review-card">
          <div class="home-review-stars" aria-label="5 out of 5 stars">★★★★★</div>
          <p>“<%= item.quote %>”</p>
          <div>
            <span class="home-review-avatar"><%= item.author.trim().charAt(0) %></span>
            <strong><%= item.author %></strong>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <section class="home-connect-grid">
    <div class="home-faq-panel faq-section">
      <div class="home-panel-heading">
        <p><%= homepage.faqs.label %></p>
        <h2><%= homepage.faqs.title %></h2>
      </div>
      <div class="faq-list">
        <% faqItems.forEach(function(item, index) { %>
          <article class="faq-item <%= index >= faqPreviewLimit ? 'faq-item-extra' : '' %>" <%= index >= faqPreviewLimit ? "hidden" : "" %>>
            <button type="button" aria-expanded="false">
              <span><%= item.question %></span>
              <i data-lucide="plus"></i>
            </button>
            <div class="faq-panel"><p><%= item.answer %></p></div>
          </article>
        <% }) %>
      </div>
      <% if (faqItems.length > faqPreviewLimit) { %>
        <button class="faq-show-more" type="button" data-faq-show-more aria-label="Show more FAQs" aria-expanded="false">
          <span>View All FAQs</span>
          <i data-lucide="chevron-down"></i>
        </button>
      <% } %>
    </div>

    <div class="home-newsletter-panel">
      <div>
        <p>Stay in the crunch loop</p>
        <h2>Get the latest launches, offers &amp; snack stories straight to your inbox.</h2>
      </div>
      <form class="newsletter-card snack-drop-form" action="/snack-drop-alerts" method="POST">
        <label class="sr-only" for="home-email"><%= homepage.newsletter.fieldLabel %></label>
        <div>
          <i data-lucide="mail"></i>
          <input id="home-email" name="email" type="email" placeholder="Enter your email address" autocomplete="email" required />
          <button type="submit">
            Subscribe Now <i data-lucide="arrow-right"></i>
          </button>
        </div>
        <p class="newsletter-status" aria-live="polite"></p>
      </form>
      <div class="home-newsletter-perks" aria-label="Newsletter benefits">
        <span><i data-lucide="badge-percent"></i> Exciting Offers</span>
        <span><i data-lucide="bell"></i> New Launch Alerts</span>
        <span><i data-lucide="book-open"></i> Crunchy Stories</span>
      </div>
    </div>
  </section>
</div>

<%- include("partials/footer") %>

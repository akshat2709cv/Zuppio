<section class="hero home-hero" id="home" style="<%= heroStyle %>">
  <div class="hero-ambient" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </div>

  <div class="hero-content scroll-reveal">
    <p class="eyebrow"><%= homepage.hero.label %></p>
    <h1><%= homepage.hero.title %></h1>
    <p><%= homepage.hero.subtitle %></p>
    <div class="hero-actions">
      <a class="button primary" href="<%= homepage.hero.primaryButtonLink %>">
        <%= homepage.hero.primaryButtonText %>
        <i data-lucide="arrow-right"></i>
      </a>
      <a class="button secondary" href="<%= homepage.hero.secondaryButtonLink %>">
        <%= homepage.hero.secondaryButtonText %>
        <i data-lucide="message-circle"></i>
      </a>
    </div>
  </div>

</section>

<section class="hero-trust-strip" aria-label="ZUPPIO brand highlights">
  <div class="hero-trust-panel">
    <% heroTrustItems.forEach(function(item) { %>
      <article class="hero-trust-item">
        <span class="hero-trust-icon" aria-hidden="true">
          <i data-lucide="<%= item.icon %>"></i>
        </span>
        <span class="hero-trust-copy">
          <strong><%= item.title %></strong>
          <small><%= item.text %></small>
        </span>
      </article>
    <% }) %>
  </div>
</section>

<section class="zuppio-universe" id="flavors" aria-labelledby="zuppioUniverseTitle">
  <div class="zuppio-universe-inner">
    <div class="universe-title-wrap">
      <span class="universe-doodle universe-doodle-left" aria-hidden="true"></span>
      <p>Our Product Universe</p>
      <h2 id="zuppioUniverseTitle">Explore the <span>Zuppio</span> World of Crunch</h2>
      <span class="universe-doodle universe-doodle-right" aria-hidden="true"></span>
    </div>

    <div class="universe-carousel-shell">
      <button class="universe-arrow universe-arrow-left" type="button" aria-label="Previous category">
        <i data-lucide="chevron-left"></i>
      </button>
      <div class="universe-category-grid">
        <% universeCategories.forEach(function(category) { %>
          <a class="universe-category-card universe-category-<%= category.theme %>" href="<%= category.link %>" aria-label="Explore <%= category.name %>">
            <img src="<%= category.image %>" alt="<%= category.name %>" loading="lazy" />
            <strong><%= category.name %></strong>
            <span class="universe-category-cta" aria-hidden="true">
              <i data-lucide="chevron-right"></i>
            </span>
          </a>
        <% }) %>
      </div>
      <button class="universe-arrow universe-arrow-right" type="button" aria-label="Next category">
        <i data-lucide="chevron-right"></i>
      </button>
    </div>

    <div class="bestseller-heading">
      <h3><i data-lucide="flame"></i> Best Sellers</h3>
      <a href="/product-categories">View All Products <i data-lucide="arrow-right"></i></a>
    </div>

    <div class="bestseller-grid">
      <% bestSellers.forEach(function(product) { %>
        <article class="bestseller-card">
          <span class="bestseller-badge">Best Seller</span>
          <a class="bestseller-image" href="/product-categories" aria-label="<%= product.name %>">
            <img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy" />
          </a>
          <div class="bestseller-card-footer">
            <h4><%= product.name %></h4>
            <div class="bestseller-price-row">
              <span><%= product.price %></span>
              <s><%= product.comparePrice %></s>
            </div>
          </div>
          <button class="bestseller-cart" type="button" aria-label="Add <%= product.name %> to cart">
            <i data-lucide="shopping-cart"></i>
          </button>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<section class="section testimonials-section">
  <div class="section-kicker">
    <p class="eyebrow"><%= homepage.testimonials.label %></p>
    <h2><%= homepage.testimonials.title %></h2>
  </div>
  <div class="swiper testimonial-swiper">
    <div class="swiper-wrapper">
      <% homepage.testimonials.items.forEach(function(item) { %>
        <article class="swiper-slide testimonial-card">
          <p><%= item.quote %></p>
          <span><%= item.author %></span>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<section class="section faq-section">
  <%
    const faqItems = homepage.faqs.items || [];
    const faqPreviewLimit = 3;
    const hasMoreFaqs = faqItems.length > faqPreviewLimit;
  %>
  <div class="section-kicker">
    <p class="eyebrow"><%= homepage.faqs.label %></p>
    <h2><%= homepage.faqs.title %></h2>
  </div>
  <div class="faq-list">
    <% faqItems.forEach(function(item, index) { %>
      <article class="faq-item <%= index >= faqPreviewLimit ? 'faq-item-extra' : '' %>" <%= index >= faqPreviewLimit ? "hidden" : "" %>>
        <button type="button" aria-expanded="false">
          <span><%= item.question %></span>
          <i data-lucide="chevron-down"></i>
        </button>
        <div class="faq-panel">
          <p><%= item.answer %></p>
        </div>
      </article>
    <% }) %>
  </div>
  <% if (hasMoreFaqs) { %>
    <button class="faq-show-more" type="button" data-faq-show-more aria-label="Show more FAQs" aria-expanded="false">
      <i data-lucide="chevron-down"></i>
    </button>
  <% } %>
</section>

<section class="section newsletter-section">
  <div class="newsletter-panel">
    <div>
      <p class="eyebrow"><%= homepage.newsletter.label %></p>
      <h2><%= homepage.newsletter.title %></h2>
    </div>
    <form class="newsletter-card snack-drop-form" action="/snack-drop-alerts" method="POST">
      <label for="home-email"><%= homepage.newsletter.fieldLabel %></label>
      <div>
        <input id="home-email" name="email" type="email" placeholder="<%= homepage.newsletter.placeholder %>" autocomplete="email" required />
        <button type="submit" aria-label="Subscribe">
          <i data-lucide="arrow-right"></i>
        </button>
      </div>
      <p class="newsletter-status" aria-live="polite"></p>
    </form>
  </div>
</section>

<%- include("partials/footer") %>

<%
  const heroConfig = homepage.hero || {};
  function cssSafe(value) {
    return String(value || "").replace(/["'()\\]/g, "");
  }
  const heroStyle = [
    heroConfig.backgroundImageDesktop ? `--home-hero-image-desktop: url('${cssSafe(heroConfig.backgroundImageDesktop)}')` : "",
    heroConfig.backgroundImageTablet ? `--home-hero-image-tablet: url('${cssSafe(heroConfig.backgroundImageTablet)}')` : "",
    heroConfig.backgroundImageMobile ? `--home-hero-image-mobile: url('${cssSafe(heroConfig.backgroundImageMobile)}')` : "",
    heroConfig.backgroundPosition ? `--home-hero-image-position: ${cssSafe(heroConfig.backgroundPosition)}` : "",
    heroConfig.backgroundOverlay !== undefined ? `--home-hero-overlay-opacity: ${Number(heroConfig.backgroundOverlay) || 0}` : ""
  ].filter(Boolean).join("; ");
%>

<%- include("partials/header") %>

